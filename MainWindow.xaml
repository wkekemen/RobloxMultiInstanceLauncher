<Window x:Class="RobloxMultiLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interop="clr-namespace:RobloxMultiLauncher.Interop"
        xmlns:views="clr-namespace:RobloxMultiLauncher.Views"
        Title="Roblox Multi-Instance Launcher" Width="1120" Height="720" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="68"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Section navigation -->
    <Border Grid.Column="0" Grid.RowSpan="3" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="10,14">
        <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource AccentBrush}" Margin="0,0,0,24"
                ClipToBounds="True">
          <Grid>
            <TextBlock Text="R" FontSize="20" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasCustomLogo}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Image Source="{Binding LogoPath}" Stretch="UniformToFill">
              <Image.Style>
                <Style TargetType="Image">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasCustomLogo}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Image.Style>
            </Image>
          </Grid>
        </Border>
        <RadioButton Style="{StaticResource NavRadio}" GroupName="nav" IsChecked="{Binding IsDashboard}"
                     ToolTip="Dashboard" AutomationProperties.Name="Dashboard">
          <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
        </RadioButton>
        <RadioButton Style="{StaticResource NavRadio}" GroupName="nav" IsChecked="{Binding IsActivity}"
                     ToolTip="Live activity" AutomationProperties.Name="Live activity">
          <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
        </RadioButton>
        <RadioButton Style="{StaticResource NavRadio}" GroupName="nav" IsChecked="{Binding IsMacros}"
                     ToolTip="Macros" AutomationProperties.Name="Macros">
          <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
        </RadioButton>
        <RadioButton Style="{StaticResource NavRadio}" GroupName="nav" IsChecked="{Binding IsMods}"
                     ToolTip="Roblox mods" AutomationProperties.Name="Roblox mods">
          <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
        </RadioButton>
        <RadioButton Style="{StaticResource NavRadio}" GroupName="nav" IsChecked="{Binding IsSettings}"
                     ToolTip="Settings" AutomationProperties.Name="Settings">
          <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
        </RadioButton>
        <RadioButton Style="{StaticResource NavRadio}" GroupName="nav" IsChecked="{Binding IsDiagnostics}"
                     ToolTip="Diagnostics" AutomationProperties.Name="Diagnostics">
          <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
        </RadioButton>
      </StackPanel>
    </Border>

    <!-- Header -->
    <Border Grid.Column="1" Grid.Row="0" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,12">
      <DockPanel>
        <TextBlock Text="Roblox Multi-Instance Launcher" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- ================= DASHBOARD ================= -->
    <Grid Grid.Column="1" Grid.Row="1" Margin="18" Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*"/>
        <ColumnDefinition Width="18"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Game to join" FontWeight="SemiBold"/>
            <TextBlock Text="Place ID or roblox.com/games/… link" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,3"/>
            <TextBox Text="{Binding PlaceInput, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Server (job) ID – optional" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,3"/>
            <TextBox Text="{Binding JobId, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="＋ Add account" Command="{Binding AddProfileCommand}" Margin="0,0,8,0"/>
              <Button Content="Launch all" Style="{StaticResource AccentButton}" Command="{Binding LaunchAllCommand}" Margin="0,0,8,0"/>
              <Button Content="Close all" Style="{StaticResource DangerButton}" Command="{Binding CloseAllSessionsCommand}"
                      ToolTip="Immediately force-close every Roblox game client, including sessions started outside this launcher."/>
            </StackPanel>
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="No accounts yet. Click “Add account” and sign in to Roblox." Foreground="{DynamicResource MutedBrush}" Margin="4,8">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Profiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Profiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UserIdText}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        <TextBlock Text="Game link or Place ID (optional)" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" Margin="0,8,0,3"/>
                        <TextBox Text="{Binding PlaceInput, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Paste a Roblox game link here to use a different game for this account. Leave blank to use the dashboard game."/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource WarnBrush}" FontSize="11" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Launch" Style="{StaticResource AccentButton}" Margin="0,0,6,0"
                                Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" IsEnabled="{Binding CanLaunch}"
                                Visibility="{Binding IsRunning, Converter={StaticResource InvBoolToVis}}"/>
                        <Button Content="Sign in again" Margin="0,0,6,0"
                                Command="{Binding DataContext.ReLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding NeedsLogin, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Close" Style="{StaticResource DangerButton}" Margin="0,0,6,0"
                                Command="{Binding DataContext.StopProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="✕" ToolTip="Remove account"
                                Command="{Binding DataContext.RemoveProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Multi-instance status" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding MultiStatus}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource BadBrush}"
                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="Roblox windows" FontWeight="SemiBold" Margin="2,0,0,8"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="No Roblox windows are running." Foreground="{DynamicResource MutedBrush}" Margin="4,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Instances.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Instances}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                      <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,8"/>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="Focus" Padding="10,4" Margin="0,0,6,0" IsEnabled="{Binding HasWindow}"
                                Command="{Binding DataContext.FocusCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        <Button Content="Minimise" Padding="10,4" Margin="0,0,6,0" IsEnabled="{Binding HasWindow}"
                                Command="{Binding DataContext.MinimizeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        <Button Content="Close" Padding="10,4" Style="{StaticResource DangerButton}"
                                Command="{Binding DataContext.CloseInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- ================= ACTIVITY ================= -->
    <Grid Grid.Column="1" Grid.Row="1" Margin="18" Visibility="{Binding IsActivity, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="2,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Live activity" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Your Roblox sessions, at a glance. Use Tab in to interact with a window."
                       Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="Screens per row" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
            <ComboBox ItemsSource="{Binding LiveActivityColumnOptions}"
                      SelectedItem="{Binding LiveActivityColumns, UpdateSourceTrigger=PropertyChanged}"
                      MinWidth="58" ToolTip="Choose how many session previews to show in each row"/>
          </StackPanel>
          <Border Grid.Column="2" Background="#202637" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="14" Padding="12,7" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource GoodBrush}" Margin="0,0,8,0"/>
              <TextBlock Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold">
                <Run Text="{Binding Instances.Count, Mode=OneWay}"/>
                <Run Text=" ACTIVE"/>
              </TextBlock>
            </StackPanel>
          </Border>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>
            <ItemsControl ItemsSource="{Binding Instances}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="{Binding DataContext.LiveActivityColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="12">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                          <Border Width="34" Height="34" CornerRadius="10" Background="#26304A" Margin="0,0,10,0">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Heading}"/>
                            <TextBlock Text="Roblox session" Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                       Margin="0,2,0,0"/>
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                          <Button Content="Tab in" Style="{StaticResource AccentButton}" Padding="10,5"
                                  Margin="0,0,6,0" IsEnabled="{Binding HasWindow}"
                                  ToolTip="Bring this Roblox window to the foreground"
                                  Command="{Binding DataContext.FocusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                          <Button Content="Close" Style="{StaticResource DangerButton}" Padding="10,5"
                                  ToolTip="Close this Roblox instance"
                                  Command="{Binding DataContext.CloseInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}"
                                 FontSize="11" TextTrimming="CharacterEllipsis" Margin="44,6,0,0"
                                 ToolTip="{Binding Details}"/>
                      <Viewbox Grid.Row="3" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <Border Width="640" Height="360" Background="#080A0F" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                          <Grid>
                            <interop:DwmThumbnailHost SourceHandle="{Binding Hwnd}"/>
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    IsEnabled="{Binding HasWindow}" ToolTip="Click to focus this Roblox window"
                                    Command="{Binding DataContext.FocusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                              <Button.Template>
                                <ControlTemplate TargetType="Button">
                                  <Border x:Name="clickOverlay" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter/>
                                  </Border>
                                  <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                      <Setter TargetName="clickOverlay" Property="Background" Value="#18000000"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                      <Setter TargetName="clickOverlay" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                      <Setter TargetName="clickOverlay" Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Button.Template>
                            </Button>
                            <TextBlock Text="Window not available" Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWindow}" Value="False">
                                      <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Grid>
                        </Border>
                      </Viewbox>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" MaxWidth="440"
                    Padding="24">
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Instances.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel HorizontalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="15" Background="#26304A" Margin="0,0,0,14">
                  <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                             Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No active Roblox windows" FontWeight="SemiBold" FontSize="16"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Launch an account from the Dashboard and its live preview will appear here."
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,7,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <!-- ================= MACROS ================= -->
    <Grid Grid.Column="1" Grid.Row="1" Margin="18" Visibility="{Binding IsMacros, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="2,0,0,16">
          <TextBlock Text="Macros" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="Record keyboard and mouse input, then replay it on demand."
                     Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
        <TabControl Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                    BorderBrush="{DynamicResource LineBrush}">
          <TabControl.Resources>
            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"/>
          </TabControl.Resources>
          <TabItem Header="Recorder">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Recording captures keyboard keys and mouse clicks across Windows while active. Do not type passwords or other sensitive information while recording."
                               TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                      <TextBlock Text="Play count" VerticalAlignment="Center" Margin="0,0,10,0"/>
                      <TextBox Text="{Binding MacroRepeatCount, UpdateSourceTrigger=PropertyChanged}"
                               Width="90" ToolTip="Enter any positive count, or 0 to repeat infinitely"/>
                      <TextBlock Text="0 = repeat infinitely; 1 = once" Foreground="{DynamicResource MutedBrush}"
                                 FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Button Content="Record" Style="{StaticResource DangerButton}" Command="{Binding StartMacroRecordingCommand}" Margin="0,0,8,0"/>
                      <Button Content="{Binding MacroPauseButtonText}" Command="{Binding PauseMacroCommand}" Margin="0,0,8,0"/>
                      <Button Content="Play / Resume" Style="{StaticResource AccentButton}" Command="{Binding PlayMacroCommand}" Margin="0,0,8,0"/>
                      <Button Content="Stop" Command="{Binding StopMacroCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding MacroStateText}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding MacroElapsedText}" FontFamily="Consolas" FontSize="24" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding MacroDetailsText}" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Save current recording" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Stop recording before saving. Playback sends the recorded sequence to the currently active app for the selected number of times."
                               Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Save recording" Style="{StaticResource AccentButton}"
                              Command="{Binding SaveMacroCommand}" Margin="8,0,0,0"/>
                      <TextBox Text="{Binding MacroName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Recording name"/>
                    </DockPanel>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Global control shortcuts" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="These shortcuts work across Windows. Select a box and press a key combination containing Ctrl, Alt, Shift, or Windows to change it."
                               Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="Record toggle" VerticalAlignment="Center" Margin="0,0,8,8"/>
                      <TextBox Grid.Column="1" Text="{Binding RecordHotkeyText, Mode=OneWay}" Tag="record" IsReadOnly="True"
                               PreviewKeyDown="MacroHotkey_PreviewKeyDown" ToolTip="Select and press a shortcut" Margin="0,0,0,8"/>
                      <TextBlock Grid.Row="1" Text="Play / resume" VerticalAlignment="Center" Margin="0,0,8,8"/>
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PlayHotkeyText, Mode=OneWay}" Tag="play" IsReadOnly="True"
                               PreviewKeyDown="MacroHotkey_PreviewKeyDown" ToolTip="Select and press a shortcut" Margin="0,0,0,8"/>
                      <TextBlock Grid.Row="2" Text="Pause / resume" VerticalAlignment="Center" Margin="0,0,8,8"/>
                      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PauseHotkeyText, Mode=OneWay}" Tag="pause" IsReadOnly="True"
                               PreviewKeyDown="MacroHotkey_PreviewKeyDown" ToolTip="Select and press a shortcut" Margin="0,0,0,8"/>
                      <TextBlock Grid.Row="3" Text="Stop" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StopHotkeyText, Mode=OneWay}" Tag="stop" IsReadOnly="True"
                               PreviewKeyDown="MacroHotkey_PreviewKeyDown" ToolTip="Select and press a shortcut"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Saved recordings">
            <DockPanel Margin="12">
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Load selected" Style="{StaticResource AccentButton}" Command="{Binding LoadMacroCommand}" Margin="0,0,8,0"/>
                <Button Content="Refresh list" Command="{Binding RefreshMacrosCommand}"/>
              </StackPanel>
              <ListBox ItemsSource="{Binding SavedMacros}" SelectedItem="{Binding SelectedSavedMacro}"
                       Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                       BorderBrush="{DynamicResource LineBrush}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="10,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}">
                          <Run Text="{Binding EventCount}"/><Run Text=" events  ·  "/><Run Text="{Binding DurationText}"/>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Grid>

    <!-- ================= MODS ================= -->
    <Grid Grid.Column="1" Grid.Row="1" Visibility="{Binding IsMods, Converter={StaticResource BoolToVis}}">
      <views:ModsView/>
    </Grid>

    <!-- ================= SETTINGS ================= -->
    <ScrollViewer Grid.Column="1" Grid.Row="1" Margin="18" VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding IsSettings, Converter={StaticResource BoolToVis}}">
      <Border Style="{StaticResource Card}" MaxWidth="720" HorizontalAlignment="Left">
        <StackPanel>
          <TextBlock Text="Roblox installation" FontWeight="SemiBold" FontSize="15"/>
          <TextBlock Text="Leave blank to auto-detect. You can point to RobloxPlayerBeta.exe, a version-… folder, or the Versions folder."
                     TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,8"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Auto-detect" Margin="6,0,0,0" Command="{Binding AutoDetectCommand}"/>
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseCommand}"/>
            <TextBox Text="{Binding RobloxPath, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11">
            <Run Text="Using: "/><Run Text="{Binding ResolvedExe, Mode=OneWay}"/>
          </TextBlock>

          <TextBlock Text="Multi-instance" FontWeight="SemiBold" FontSize="15" Margin="0,22,0,6"/>
          <CheckBox IsChecked="{Binding AttemptMultiInstance}" Foreground="{DynamicResource TextBrush}"
                    Content="Attempt multi-instance (pre-create Roblox's single-instance objects in this launcher)"/>
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="22,4,0,0"
                     Text="This does not touch Roblox files or processes. It may stop working at any time when Roblox updates, and Roblox does not officially support running several clients."/>

          <TextBlock Text="Launch timeout (seconds)" Margin="0,18,0,4"/>
          <TextBox Text="{Binding LaunchTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>

          <TextBlock Text="Sessions per row" Margin="0,18,0,4"/>
          <TextBox Text="{Binding SessionsPerRow, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"
                   IsEnabled="{Binding AutoArrangeWindows}"
                   ToolTip="Choose how many Roblox session windows to place in each row (1–12)."/>

          <TextBlock Text="Session monitor" FontWeight="SemiBold" FontSize="15" Margin="0,22,0,6"/>
          <CheckBox IsChecked="{Binding AutoArrangeWindows}" Foreground="{DynamicResource TextBrush}"
                    Content="Automatically arrange Roblox windows after each launch" Margin="0,0,0,6"/>
          <TextBlock Text="When on, launcher-started Roblox windows are arranged compactly on this monitor after each successful launch. When off, windows stay where Roblox opens them."
                     TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/>
          <ComboBox ItemsSource="{Binding AvailableMonitors}" DisplayMemberPath="DisplayName"
                    SelectedValuePath="DeviceName" SelectedValue="{Binding SelectedMonitorDeviceName}"
                    IsEnabled="{Binding AutoArrangeWindows}"
                    HorizontalAlignment="Left" MinWidth="320"/>

          <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="15" Margin="0,22,0,6"/>
          <TextBlock Text="Enter colors as #RRGGBB or #AARRGGBB." Foreground="{DynamicResource MutedBrush}"
                     FontSize="11" Margin="0,0,0,8"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="100"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Background" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox Grid.Column="1" Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
            <TextBlock Grid.Column="3" Text="Panel" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox Grid.Column="4" Text="{Binding PanelColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="Cards" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CardColor, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="Accent" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Apply colors" Style="{StaticResource AccentButton}" Command="{Binding ApplyAppearanceCommand}"/>
          </StackPanel>

          <TextBlock Text="Application logo" FontWeight="SemiBold" Margin="0,18,0,6"/>
          <TextBlock Text="Choose a PNG, JPG, or BMP image for the launcher badge." Foreground="{DynamicResource MutedBrush}"
                     FontSize="11" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="Choose logo…" Command="{Binding SelectLogoCommand}" Margin="0,0,8,0"/>
            <Button Content="Use default logo" Command="{Binding ClearLogoCommand}"/>
          </StackPanel>
          <TextBlock Text="{Binding LogoPath}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"
                     FontSize="10" Margin="0,6,0,0"/>
          <TextBlock Text="Live previews are view-only. Use Tab in to bring the normal Roblox window forward for mouse and keyboard interaction."
                     TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,18,0,0"/>

          <Button Content="Save settings" Style="{StaticResource AccentButton}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,22,0,0"/>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- ================= DIAGNOSTICS ================= -->
    <DockPanel Grid.Column="1" Grid.Row="1" Margin="18" Visibility="{Binding IsDiagnostics, Converter={StaticResource BoolToVis}}">
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Troubleshooting" FontWeight="SemiBold" FontSize="15"/>
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"><Run Text="Roblox: " Foreground="{DynamicResource MutedBrush}"/><Run Text="{Binding ResolvedExe, Mode=OneWay}"/></TextBlock>
          <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="Version folder: " Foreground="{DynamicResource MutedBrush}"/><Run Text="{Binding RobloxVersion, Mode=OneWay}"/></TextBlock>
          <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding SingletonStatus}"/>
          <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding OutsideInfo}"/>
          <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11">
            <Run Text="If a second launch fails: (1) close every Roblox window and the Roblox tray icon, (2) turn off Roblox's start-with-Windows option, (3) restart this launcher so it claims the objects first, (4) launch accounts one after another. If it still fails, this Roblox build probably blocks multiple clients and no supported method exists."/>
          </TextBlock>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Re-check" Margin="0,0,8,0" Command="{Binding RefreshDiagnosticsCommand}"/>
            <Button Content="Close Roblox processes not started by this launcher" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Command="{Binding CloseOutsideCommand}"/>
            <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <ListBox ItemsSource="{Binding LogLines}" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
               BorderBrush="{DynamicResource LineBrush}" FontFamily="Consolas" FontSize="11"/>
    </DockPanel>

    <!-- Status bar -->
    <Border Grid.Column="1" Grid.Row="2" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding SingletonStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
