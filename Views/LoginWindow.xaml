<Window x:Class="RobloxMultiLauncher.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to Roblox" Width="520" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Padding="12" Background="{DynamicResource PanelBrush}">
      <TextBlock TextWrapping="Wrap" FontSize="12"
                 Text="Sign in on the real roblox.com page below. Your password goes only to Roblox; this app never sees it. The window closes automatically once you are signed in, and the session is stored encrypted with Windows DPAPI."/>
    </Border>
    <wv2:WebView2 x:Name="Web" Grid.Row="1"/>
  </Grid>
</Window>
